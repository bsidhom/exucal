# Wrangler system environment variables. Wrangler loads this file from the
# project root on every command, so settings here apply to every machine and
# CI run without per-user setup. This file is committed: keep secrets out of it
# and put them in `.env.local`, which is gitignored.

# Turn off Wrangler's usage telemetry. `send_metrics` in `wrangler.jsonc` does
# the same for most events, but wrangler's "autoconfig" events are sent without
# reading the project config and only respect this variable (or DO_NOT_TRACK).
# https://github.com/cloudflare/workers-sdk/blob/main/packages/wrangler/telemetry.md
WRANGLER_SEND_METRICS=false
