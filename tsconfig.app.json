// The app: everything under `src/` except the service worker and the tests,
// which run in Node.js and are checked by tsconfig.node.json.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/sw.ts", "src/**/*.test.ts"]
}
