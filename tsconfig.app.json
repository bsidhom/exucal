// The app: everything under `src/` except the service worker, the tests and
// the test support in src/testing/, which run in Node.js and are checked by
// tsconfig.node.json.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/sw.ts", "src/**/*.test.ts", "src/testing"]
}
