// Everything that runs in Node.js rather than a browser: the build
// configuration and its plugins, the tests, the test support in
// src/testing/, the benchmarks and the scripts' tests, and the modules of
// src/ they reach, the core among them, which is pure TypeScript with no
// DOM dependency and checks the same under either `lib`. The patterns
// match every TypeScript file in those places, so a new one is checked
// here without being listed; only the browser-only modules are excluded,
// each because it needs the DOM or Vite's types (tsconfig.app.json checks
// them, and tsconfig.sw.json the service worker). A file that needs the
// DOM fails here until it is excluded, which is loud, where a file no
// pattern matched would go unchecked in silence; tsconfig-coverage.test.ts
// fails on any file no project checks.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["*.ts", "src/**/*.ts", "bench/**/*.ts", "scripts/**/*.ts"],
  "exclude": [
    "src/main.ts",
    "src/app-shell.ts",
    "src/app-footer.ts",
    "src/unit-converter.ts",
    "src/register-service-worker.ts",
    "src/system-table.ts",
    "src/sw.ts"
  ]
}
