// Everything that runs in Node.js rather than a browser: the build
// configuration and its plugins, the tests and the benchmarks. The core's
// tests run here too, and a composite project must list every file it
// reaches, so the core itself is included as well; it is pure TypeScript
// with no DOM dependency and checks the same under either `lib`.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "vite-plugin-icons.ts",
    "vite-plugin-precache.ts",
    "vite-plugin-precache.test.ts",
    "rasterize-svg.ts",
    "rasterize-svg.test.ts",
    "src/core/**/*.ts",
    "src/units.test.ts",
    "src/messages.ts",
    "src/messages.test.ts",
    "src/settings.ts",
    "src/settings.test.ts",
    "bench/**/*.ts"
  ]
}
