// The build configuration, which runs in Node.js rather than a browser.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "vite-plugin-precache.ts",
    "vite-plugin-precache.test.ts"
  ]
}
