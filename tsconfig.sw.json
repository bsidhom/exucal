// The service worker. It runs in a worker scope, so it is checked against the
// `webworker` lib instead of `dom`; the two cannot be combined in one program.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "webworker"],
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo"
  },
  "include": ["src/sw.ts"]
}
