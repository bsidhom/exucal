// Wrangler configuration for deploying the built site to Cloudflare Workers.
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exucal",
  // The Workers runtime behaves as it did on this date. Keep it as recent as
  // the pinned wrangler supports: it must not be newer than the workerd
  // version that wrangler bundles (see its version in pnpm-lock.yaml), and
  // it is worth bumping whenever wrangler is updated.
  "compatibility_date": "2026-09-08",
  // Wrangler sends usage telemetry to Cloudflare by default. Opt out here so
  // it stays off for every machine and CI run that uses this config, without
  // relying on a per-user `wrangler telemetry disable` or an environment
  // variable. See
  // https://github.com/cloudflare/workers-sdk/blob/main/packages/wrangler/telemetry.md
  "send_metrics": false,
  // The site is static assets only. `pnpm build` writes them to `dist`.
  "assets": {
    "directory": "./dist",
  },
  // Serve the app in production from a custom domain only, so that it has
  // one origin: a PWA's installs and saved settings belong to the origin
  // they were made on. The domain is attached in the Cloudflare dashboard,
  // not listed here, so that anyone can deploy this repository to their own
  // domain without editing it; wrangler never removes a domain added in the
  // dashboard. To deploy without a custom domain, set this to true.
  "workers_dev": false,
  // Keep Preview URLs on workers.dev as well as on any custom domain set up
  // for Previews, so that a Preview stays reachable even if the domain's
  // routing breaks. Set explicitly because, when it is absent, Preview URLs
  // follow workers_dev, which is off. Wrangler applies both settings on
  // every `wrangler deploy` (Previews do not change them), so a change made
  // only in the dashboard lasts until the next production deploy.
  "preview_urls": true,
}
